# Copy to .env and fill in. .env is ignored by git and docker; never commit real tokens.

# OpenAI-compatible base URL of the news model, up to and including /v1
#   model on OpenShift AI, service on your laptop: the model's public route
#   model on OpenShift AI, service in the cluster:  the internal .svc.cluster.local URL
#   local Ollama, service run with uvicorn:          http://localhost:11434/v1
#   local Ollama, service run in Docker:             http://host.docker.internal:11434/v1
#     (inside a container "localhost" is the container itself -> "Connection refused")
LLM_BASE_URL=https://<model-route>/v1
# served model name, see: curl $LLM_BASE_URL/models
LLM_MODEL=<model-name>
# bearer token of the model endpoint (leave empty if token auth is off)
LLM_API_KEY=

# optional (no comments after values: docker --env-file would read them as part of the value)
# "false" for self-signed cluster certificates, or a path to a CA bundle
# LLM_VERIFY_TLS=true
# LLM_TIMEOUT_S=60
# LLM_MAX_TOKENS=1000
# LLM_JSON_MODE=true
# DATA_DIR=data
