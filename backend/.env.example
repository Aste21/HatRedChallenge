# Copy to backend/.env for local dev (never commit .env).
# In-cluster: https://<inference-service>-predictor.<namespace>.svc.cluster.local:8443/v1
# Local dev: use the external Route of the InferenceService (see RHOAI dashboard -> Models -> endpoint).
LLM_BASE_URL=https://<inference-service-route>/v1
# Leave empty to use the first model returned by GET /v1/models
LLM_MODEL=
LLM_API_KEY=<service-account-token-from-rhoai-dashboard>
# Path to the cluster CA bundle; preferred over disabling verification
LLM_CA_BUNDLE=
# Only for local dev when no CA bundle is available
LLM_VERIFY_TLS=true
# SQLite file for chat history; defaults to backend/var/autonomous-cfo.sqlite3. In-cluster point it at the PVC.
# DATABASE_PATH=/data/autonomous-cfo.sqlite3
